{
  "multipart": [
    {
      "when": {
        "fruiting": "false"
      },
      "apply": {
        "model": "uwudimension:block/heartbloom_leaves"
      }
    },
    {
      "when": {
        "fruiting": "true"
      },
      "apply": {
        "model": "uwudimension:block/heartbloom_leaves_fruiting"
      }
    }
  ]
}
