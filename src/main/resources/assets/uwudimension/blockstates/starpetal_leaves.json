{
  "multipart": [
    {
      "when": {
        "fruiting": "false"
      },
      "apply": {
        "model": "uwudimension:block/starpetal_leaves"
      }
    },
    {
      "when": {
        "fruiting": "true"
      },
      "apply": {
        "model": "uwudimension:block/starpetal_leaves_fruiting"
      }
    }
  ]
}
